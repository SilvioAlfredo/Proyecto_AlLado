{
  "name": "al_lado-app",
  "version": "0.1.0",
  "private": true,
 "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --reporter=junit --outputFile=test-results/junit.xml",
    "test:watch": "vitest",
    "lint": "eslint",
    "format:admin": "prettier --write \"src/app/admin/**/*.{ts,tsx}\" \"src/features/admin/**/*.{ts,tsx}\" \"src/app/acceso-admin/**/*.tsx\" src/features/auth/components/LoginForm.tsx",
    "format:admin:check": "prettier --check \"src/app/admin/**/*.{ts,tsx}\" \"src/features/admin/**/*.{ts,tsx}\" \"src/app/acceso-admin/**/*.tsx\" src/features/auth/components/LoginForm.tsx",
    "docs": "typedoc --options typedoc.json",
    "docs:watch": "typedoc --options typedoc.json --watch",
    "knip": "knip",
    "api:types": "openapi-typescript http://localhost:8080/v3/api-docs -o src/types/api.generated.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "openapi-typescript": "^7.4.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
