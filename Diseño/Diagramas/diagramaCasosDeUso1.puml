@startuml
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 20

actor "Empleador" as E
actor "Trabajador" as T

rectangle "Sistema AlLado - Operaciones" {
    usecase "Publicar Necesidad\n(Postulación Inversa)" as UC1
    usecase "Ver Perfil de Trabajadores" as UC2
    usecase "Postularse a Oferta" as UC3
    usecase "Recibir Notificación de Trabajo" as UC4
    usecase "Calificar Servicio" as UC5
    usecase "Gestionar Favoritos" as UC6
    usecase "Validar Identidad\n(Sello de Confianza)" as UC7
    
    ' Extensiones y dependencias
    UC1 ..> UC4 : <<include>>
    UC3 ..> UC7 : <<extension>> : Solo usuarios PRO
}

E --> UC1
E --> UC2
E --> UC5
E --> UC6

T --> UC3
T --> UC4
T --> UC7
@enduml