@startuml CasosDeUso2
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 20

title AlLado - Casos de uso: comunidad, planes y administración

actor "Usuario (Empleador o Trabajador)" as U
actor "Empleador" as E
actor "Administrador" as A

rectangle "Sistema AlLado - Gestión y Comunidad" {
    usecase "Reportar comportamiento\ninapropiado" as UC1
    usecase "Participar en el foro\nvecinal" as UC2
    usecase "Leer comunicados" as UC3
    usecase "Realizar donación /\naporte" as UC4
    usecase "Adquirir plan PRO" as UC5
    usecase "Publicar publicidad\nde cercanía" as UC6
    usecase "Gestionar perfil\nempresarial" as UC7

    usecase "Moderar reportes" as UC8
    usecase "Gestionar etiquetas\n(taxonomía)" as UC9
    usecase "Verificar perfiles\nempresariales" as UC10
    usecase "Verificar aportes y\nsuscripciones" as UC11
    usecase "Gestionar publicidades" as UC12
    usecase "Emitir comunicados" as UC13
    usecase "Gestionar usuarios\ny empresas" as UC14
    usecase "Consultar métricas\ndel dashboard" as UC15

    UC1 ..> UC8 : <<include>>
    UC5 ..> UC11 : <<include>>
    UC7 ..> UC10 : <<include>>
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5

E --> UC6
E --> UC7

A --> UC8
A --> UC9
A --> UC10
A --> UC11
A --> UC12
A --> UC13
A --> UC14
A --> UC15

note right of UC4
  El aporte queda PENDIENTE.
  El Administrador lo verifica
  por asunto y monto bancario.
end note

note right of UC15
  Métricas de ingresos son
  estimaciones, no cobros
  auditados.
end note

@enduml
