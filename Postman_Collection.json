  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-AUTH-001: el login devuelve token e identidad HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "    const identity = pm.response.json();",
              "    pm.expect(identity.token).to.be.a('string').and.not.empty;",
              "    pm.expect(identity.id).to.be.a('number');",
              "    pm.environment.set('authToken', identity.token);",
              "    pm.environment.set('userId', String(identity.id));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
