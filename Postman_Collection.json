{
  "info": {
    "name": "AlLado API",
    "description": "Postman collection for testing AlLado Backend endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "allado-api-collection"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "oportunidadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "postulacionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"trabajador@test.com\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().token).to.exist;",
              "    pm.collectionVariables.set('authToken', pm.response.json().token);",
              "    pm.collectionVariables.set('userId', pm.response.json().id || '1');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Auth - Register Trabajador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"trabajador@test.com\",\n  \"password\": \"password123\",\n  \"telefono\": \"+5491123456789\",\n  \"rol\": \"TRABAJADOR\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Register successful', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().token).to.exist;",
              "    pm.collectionVariables.set('authToken', pm.response.json().token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
