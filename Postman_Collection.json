    {
      "name": "Comunidad / Notificaciones",
      "description": "Precondición: authToken y userId pertenecen al empleador titular y existe al menos una notificación sin leer, generada por una postulación nueva. otroUsuarioId debe ser distinto del titular; notificacionAjenaId debe pertenecer a otro usuario. Ejecutar en orden.",
      "item": [
        {
          "name": "Notificaciones - Listar del titular",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-NOTIF-004: el titular lista sus notificaciones con HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const items = pm.response.json();",
                  "    pm.expect(items).to.be.an('array');",
                  "    const pendiente = items.find((item) => item.leida === false);",
                  "    pm.expect(pendiente, 'Se requiere una notificación sin leer').to.exist;",
                  "    pm.environment.set('notificacionId', String(pendiente.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notificaciones/usuario/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["notificaciones", "usuario", "{{userId}}"]
            }
          }
        },
        {
          "name": "Notificaciones - Contar pendientes antes",
