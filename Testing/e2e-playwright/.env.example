# Copiar a .env y ajustar si el entorno no usa los valores por defecto.
# Playwright no lee .env por sí solo: exportar estas variables antes de `npm test`.

# URL del frontend Next.js
E2E_BASE_URL=http://localhost:3001

# URL del backend Spring Boot (usada para preparar datos de los escenarios)
E2E_API_URL=http://localhost:8081

# Credenciales sembradas en la base de QA (perfil spring `e2e`)
E2E_ADMIN_EMAIL=admin@allado.com
E2E_ADMIN_PASSWORD=Clave123!
