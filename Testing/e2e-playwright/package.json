{
  "name": "al-lado-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Suite E2E de AlLado con Playwright Test, TypeScript y Page Object Model",
  "scripts": {
    "test": "playwright test",
    "test:flow": "playwright test tests/flow-*.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:fallo": "playwright test --config=playwright.evidencia.config.ts",
    "test:capturas": "playwright test tests/flow-*.spec.ts",
    "report": "playwright show-report results/html-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
