# =============================================================================
# Variables de entorno para AlLado Backend
# Copiar a .env y ajustar valores antes de ejecutar
# =============================================================================

# --- Base de datos PostgreSQL (AL-SEC-002) ---
DB_URL=jdbc:postgresql://localhost:5432/al_lado_db
DB_USERNAME=postgres
DB_PASSWORD=tu_password_seguro

# --- Seguridad JWT (AL-SEC-001) ---
# Clave mínima 32 bytes (256 bits) para HS256
JWT_SECRET=tu_clave_secreta_muy_larga_y_segura_minimo_32_caracteres
JWT_EXPIRATION=86400000

# --- Tokens de recuperación y verificación (AL-SEC-004) ---
AUTH_RECOVERY_TTL_MINUTES=30
AUTH_VERIFICATION_TTL_MINUTES=1440

# --- Perfil de pruebas E2E (opcional) ---
E2E_DB_URL=jdbc:postgresql://localhost:5433/al_lado_db
E2E_DB_USERNAME=postgres
E2E_DB_PASSWORD=
E2E_BACKEND_PORT=8081

# =============================================================================
