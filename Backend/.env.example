# =============================================================================
# Variables de entorno del backend (AL-SEC-001 / AL-SEC-002).
# -----------------------------------------------------------------------------
# Copiá este archivo a ".env" (no lo subas al repositorio) y exportá las
# variables antes de iniciar el backend:
#
#   set -a && source .env && set +a
#   ./mvnw spring-boot:run
#
# Ningún secreto real se guarda en el repositorio: el proceso de arranque
# falla de forma explícita si falta JWT_SECRET o DB_PASSWORD.
# =============================================================================

# --- Base de datos (obligatorio en producción) ---
DB_URL=jdbc:postgresql://localhost:5432/al_lado_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- Firma JWT (obligatorio) ---
# Clave aleatoria de al menos 32 bytes. Generala con:
#   openssl rand -base64 48
JWT_SECRET=

# --- Opcionales: con estos valores por defecto ---
# JWT_EXPIRATION=86400000
# AUTH_RECOVERY_TTL_MINUTES=30
# AUTH_VERIFICATION_TTL_MINUTES=1440
