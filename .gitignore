# Ignorar la carpeta de compilación de Maven
target/

# Ignorar archivos de configuración del IDE (IntelliJ, Eclipse, VS Code)
.idea/
*.iml
.classpath
.project
.settings/
.vscode/

# Ignorar archivos de sistema o logs
*.log
.DS_Store

# Resultados JUnit generados por las suites de los frontends (se regeneran)
Frontend/*/test-results/

# Copias de seguridad de la planilla de pruebas (se regeneran)
*.xlsx.bak

# Ignorar secretos: solo se versiona el ejemplo .env.example (AL-SEC-001/002)
.env
.env.*
!.env.example

# Ignorar repositorio y metadatos de Mercurial
.hg/
.hgignore
.hgtags

# Bytecode compilado de Python (scripts de pruebas E2E)
__pycache__/
*.pyc
